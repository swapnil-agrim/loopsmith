__pycache__/
*.pyc
.pytest_cache/
.coverage

# dogfood loop scratch (the kit runs its own SDLC locally; not part of the plugin)
.sdlc/

# python build/venv trees (insight/ becomes pip-installable in E0.S2).
# ANCHORED on purpose: a bare `dist/` or `build/` matches at ANY depth, which would silently
# untrack — and therefore un-guard — real modules like insight/metrics/dist/. Only the two places
# build output actually lands are ignored.
.venv/
venv/
/build/
/dist/
/insight/build/
/insight/dist/
*.egg-info/
