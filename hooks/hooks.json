{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/sdlc_gate.sh\"",
            "statusMessage": "Applying goal-based SDLC policy"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "WebSearch|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/_py.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/research_capture.py\"",
            "statusMessage": "Capturing research to the knowledge graph"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/plan_gate.sh\"",
            "statusMessage": "Checking the hard plan-gate (opt-in)"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/_py.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/decision_gate.py\"",
            "statusMessage": "Checking the decision registry"
          }
        ]
      }
    ]
  }
}
