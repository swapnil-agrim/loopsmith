{
  "_comment": "Authoritative machine config for the loop. Mirrors project.md prose; this file wins on conflict.",
  "mode": { "default": "goal" },
  "discovery": {
    "source": "local-goals",
    "_source_options": "local-goals (files in .sdlc/goals/) | github (issues labelled sdlc:goal, needs the gh CLI)",
    "github": {
      "repo": "",
      "goal_label": "sdlc:goal",
      "in_progress_label": "sdlc:in-progress",
      "parked_label": "sdlc:parked",
      "assignee": "",
      "_assignee": "Optional. Set to \"@me\" (or a username) to only pick issues assigned to that user, so several people can run the loop on one shared board without grabbing each other's work. Empty = no filter (every open goal issue is in scope).",
      "project": {
        "enabled": true,
        "_comment": "Mirror issue status onto a GitHub Projects v2 board (needs the gh `project` scope). Flow: Backlog -> In Progress -> QC -> Done, Blocked for parked. Fail-open: if it can't, the loop still runs on issues+labels.",
        "owner": "",
        "title": "",
        "number": null,
        "status_field": "Status",
        "columns": { "backlog": "Backlog", "in_progress": "In Progress", "qc": "QC", "done": "Done", "blocked": "Blocked" }
      }
    }
  },
  "budget": { "max_iterations": 20, "max_tokens": 500000, "max_minutes": 480 },
  "gates": {
    "hard_plan_gate": { "enabled": false, "plan_freshness_hours": 24 },
    "irreversible_actions": ["deploy", "delete", "overwrite", "spend", "migrate"],
    "on_block": "park"
  },
  "verify": { "command": "", "enforce": false },
  "work": {
    "enabled": false,
    "_comment": "One git worktree + branch + PR per goal, so the loop never moves your checkout - and never rewrites .sdlc/goals/ underneath itself by switching branches. The worktree is cut fresh from <remote>/<base>, which IS the goal-start rebase: nothing to replay, so it cannot conflict or strand a half-applied tree. verify_command then runs IN that worktree, because the main checkout does not contain the change. Off by default; absent, the loop writes to git exactly as little as before. Gitignore .sdlc/work/.",
    "base": "",
    "_base": "The integration branch to cut from and target. Empty = whichever branch the loop was started on.",
    "remote": "origin",
    "branch_prefix": "sdlc/",
    "worktree_dir": ".sdlc/work",
    "auto_merge": "off",
    "_auto_merge": "off (default, never merges) | protected (merge only where branch protection actually REQUIRES checks or reviews - i.e. delegate the gate to GitHub) | always (merge whenever clean+safe, even on an unprotected branch, where nothing but the local verify gated it). Legacy booleans still parse: false=off, true=always.",
    "_auto_merge_2": "Whatever the setting, a merge needs BOTH this run's fresh passing verify evidence AND GitHub's mergeable + mergeStateStatus CLEAN, and it then arms GitHub's own --auto so the last word is an atomic re-check at merge time. A BEHIND branch is rebased once and re-checked; anything else parks with the reason.",
    "_auto_merge_3": "PERMISSION is never a config question: a fork PR, or a repo you only have read/triage access to, opens the PR and stops there - that is the open-source path, where the PR IS the deliverable. It records `done`, not a park.",
    "merge_method": "squash",
    "require_review": "off",
    "_require_review": "off (default) | changes | approval. A REAL PR-review gate, independent of branch protection. `gate()`'s mergeStateStatus only folds in reviews the base branch PROTECTION requires, so a human 'Request changes' on an unprotected base (a common staging/dev shape) is invisible to auto-merge. `changes` parks on a CHANGES_REQUESTED review or an unresolved review thread; `approval` also requires an APPROVED reviewDecision before merging. Self-review before the PR is never enough on its own - this is the review AFTER the PR. Adds a `gh pr view` read per merge; fail-open on a read error.",
    "_require_review_2": "THE LOOP REVIEWS ITS OWN PR - no human required. This is the READ side of the gate; the WRITE side is `work.py post-review`: after opening the PR, the loop runs a fresh adversarial pass over the real diff and posts `loopsmith:approve` (clears the merge) or `loopsmith:block` (sends itself back to fix + re-review). GitHub forbids formally approving your OWN PR and the loop is always the author, so a plain comment is the channel: loopsmith:approve/block/unblock, latest wins, a block overrides an approve. The same markers let a human review a loop PR too; a formal APPROVE / unresolved thread also counts when a second identity leaves one. Drive it via /sdlc-loop."
  },
  "ledger": {
    "enabled": false,
    "_comment": "Append-only team record of what the loop did: .sdlc/ledger/entries/<actor>.jsonl, ONE FILE PER PERSON (you only ever write your own, so concurrent appends cannot conflict). The team view is their union - render it with `ledger.py render <dir> --write`. Off by default; absent, the loop behaves exactly as before.",
    "actor": "",
    "_actor": "Your handle in the ledger. Empty = resolved from the authenticated account (`gh api user`), else the shell user.",
    "owners": {},
    "_owners": "Optional area -> owner overrides, e.g. {\"engine\": \"@some-login\"}. Empty = the roster is the repo's own .github/CODEOWNERS, which the host already enforces on every PR.",
    "handoff": { "label": "sdlc:dependency" },
    "_handoff": "A cross-area blocker opens an issue in the owner's area, assigned to them and carrying the goal label, so their own loop picks it up. See handoff.py.",
    "branch": "sdlc-ledger",
    "remote": "origin",
    "_branch": "The ops branch the ledger is shared on. .sdlc/ledger/ is a WORKTREE checked out to it (turn `enabled` on, then run /sdlc-ledger — or `sync.py bootstrap` — once per clone to create+seed+push it), so pulling the ledger never touches your code checkout. It is never merged into the integration branch and never runs CI - keep it unprotected. Gitignore .sdlc/ledger/ on the code branch.",
    "watch": { "interval_seconds": 900 },
    "_watch": "How often watch.sh pulls the ops branch and refreshes .sdlc/state/inbox.md, which `loop.py next` surfaces between goals.",
    "lease": { "ttl_hours": 12 },
    "_lease": "Claim lease: the loop skips a goal another actor holds an open `claimed` on (not yet done/parked/failed), so two people on one board don't start the same goal; a goal YOU hold is still yours to resume. Advisory (it sees claims already pulled to the ops branch, not a distributed lock), so keep assignee routing on too. ttl_hours expires a crashed claimer's hold so it can't block the team forever; 0 = never expire."
  },
  "parallel": { "enabled": false, "max_concurrent": 3 },
  "_parallel": "Run a goal's independent slices concurrently, from the declared manifest .sdlc/plans/<goal-stem>.slices.json: `slices.py plan` groups non-conflicting slices into waves (a slice that declares no files conflicts with everything and runs alone) and the loop dispatches each wave as subagents. Off by default; absent, every goal runs as one unit exactly as before.",

  "companions": "auto",
  "model_selection": "off",
  "_model_selection_options": "off (phases run at the session model) | auto (predict a tier per goal via /sdlc-model, run that goal's phases as subagents at it)",
  "knowledge_graph": {
    "enabled": false,
    "scope": "full",
    "_scope_options": "full (code + external research + internal analysis) | research (skip code; internal analysis + external research only)",
    "builder": "graphify",
    "auto_refresh": false
  }
}
