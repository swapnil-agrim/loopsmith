{
  "_comment": "Authoritative machine config for the loop. Mirrors project.md prose; this file wins on conflict.",
  "mode": { "default": "goal" },
  "discovery": {
    "source": "local-goals",
    "_source_options": "local-goals (files in .sdlc/goals/) | github (issues labelled sdlc:goal, needs the gh CLI)",
    "github": {
      "repo": "",
      "goal_label": "sdlc:goal",
      "in_progress_label": "sdlc:in-progress",
      "parked_label": "sdlc:parked",
      "assignee": "",
      "_assignee": "Optional. Set to \"@me\" (or a username) to only pick issues assigned to that user, so several people can run the loop on one shared board without grabbing each other's work. Empty = no filter (every open goal issue is in scope).",
      "project": {
        "enabled": true,
        "_comment": "Mirror issue status onto a GitHub Projects v2 board (needs the gh `project` scope). Flow: Backlog -> In Progress -> QC -> Done, Blocked for parked. Fail-open: if it can't, the loop still runs on issues+labels.",
        "owner": "",
        "title": "",
        "number": null,
        "_number": "PIN THIS to your board's number if a board already exists. loopsmith resolves a board by `number`, else by exact `title`, else by its default title `<repo> - SDLC`; if none matches it CREATES one. With no number set and a real board titled differently, that create would be a silent DUPLICATE the loop then manages instead of yours - so if the owner already has board(s) loopsmith now REFUSES to create and warns instead (set this). Leave null only for a fresh repo with no board yet. /sdlc-doctor flags the risk.",
        "status_field": "Status",
        "columns": { "backlog": "Backlog", "in_progress": "In Progress", "qc": "QC", "done": "Done", "blocked": "Blocked" },
        "custom_fields": {},
        "_custom_fields": "Values loopsmith stamps on your board's CUSTOM single-select fields for any issue IT creates (today: cross-area hand-offs), so a loop-made issue isn't silently blank on a field like Priority/Section while every human-made issue carries it. Map field NAME -> option NAME, e.g. {\"Priority\": \"Medium\", \"Section\": \"Task\"}. ONLY single-select fields are settable (like the built-in Status); a field the board lacks, or a value that isn't one of its options, is skipped - not guessed. Empty {} = the historical behavior (loopsmith sets only labels + assignee + the built-in Status). NOTE a `priority:<n>` LABEL is a different mechanism from a Projects-v2 Priority FIELD; this maps the field. /sdlc-doctor lists any single-select field you left unmapped."
      }
    }
  },
  "budget": { "max_iterations": 20, "max_tokens": 500000, "max_minutes": 480 },
  "gates": {
    "hard_plan_gate": { "enabled": false, "plan_freshness_hours": 24 },
    "stop_gate": { "enabled": false, "plan_freshness_hours": 24 },
    "_stop_gate": "OPT-IN Stop hook (completion_gate.sh). When enabled:true, refuses to let the agent STOP with unplanned SOURCE changes in the working tree (no fresh plan under .sdlc/plans/ within plan_freshness_hours) — the Stop-time counterpart to hard_plan_gate. Catches an interactive /sdlc-goal session ending early; the loop's own record step is already guarded. Off by default (installing changes nothing). Escape hatch: touch .sdlc/.allow-direct-edits. Fail-open on no python3/git/config.",
    "_decision_gate": "PreToolUse hook (decision_gate.py) — the one guardrail here that is NOT a prompt: an edit that assigns a registered invariant a violating value is DENIED, not discouraged. Unlike the other gates there is no `enabled: true` to set — AUTHORING .sdlc/decisions.json is the opt-in, so no registry means no behavior. Run /sdlc-decide to write one, then `decision_gate.py check .` to see whether the code you already have complies. Add `\"decision_gate\": {\"enabled\": false}` here only to switch it OFF without deleting the registry (a refactor that intentionally moves an invariant). /sdlc-doctor reports how many decisions are active.",
    "irreversible_actions": ["deploy", "delete", "overwrite", "spend", "migrate"],
    "on_block": "park"
  },
  "verify": { "command": "", "enforce": false },
  "session_start": { "enabled": false },
  "_session_start": "OPT-IN SessionStart hook (session_start.sh). When enabled:true, injects a short SDLC policy brief + a doctor-lite install self-check as additionalContext at the start of every session, so LoopSmith's conventions are in context before the first prompt (the UserPromptSubmit gate only fires once you type). Advisory only — never blocks; the self-check warns. Off by default: silent unless a .sdlc/ exists AND this is true. Fail-open on no python3/config.",
  "work": {
    "enabled": false,
    "_comment": "One git worktree + branch + PR per goal, so the loop never moves your checkout - and never rewrites .sdlc/goals/ underneath itself by switching branches. The worktree is cut fresh from <remote>/<base>, which IS the goal-start rebase: nothing to replay, so it cannot conflict or strand a half-applied tree. verify_command then runs IN that worktree, because the main checkout does not contain the change. Off by default; absent, the loop writes to git exactly as little as before. Gitignore .sdlc/work/.",
    "base": "",
    "_base": "The integration branch to cut from and target. Empty = whichever branch the loop was started on.",
    "remote": "origin",
    "branch_prefix": "sdlc/",
    "worktree_dir": ".sdlc/work",
    "auto_merge": "off",
    "_auto_merge": "off (default, never merges) | protected (merge only where branch protection actually REQUIRES checks or reviews - i.e. delegate the gate to GitHub) | always (merge whenever clean+safe, even on an unprotected branch, where nothing but the local verify gated it). Legacy booleans still parse: false=off, true=always.",
    "_auto_merge_2": "Whatever the setting, a merge needs BOTH this run's fresh passing verify evidence AND GitHub's mergeable + mergeStateStatus CLEAN, and it then arms GitHub's own --auto so the last word is an atomic re-check at merge time. A BEHIND branch is rebased once and re-checked; anything else parks with the reason.",
    "_auto_merge_3": "PERMISSION is never a config question: a fork PR, or a repo you only have read/triage access to, opens the PR and stops there - that is the open-source path, where the PR IS the deliverable. It records `done`, not a park.",
    "merge_method": "squash",
    "require_review": "off",
    "max_review_cycles": 3,
    "_max_review_cycles": "Hard cap on the loop's own review->fix->re-review loop (require_review on). Each `loopsmith:block` the loop posts counts a cycle; at this many it stops asking for more and PARKS the goal for a human instead of churning forever if the review keeps finding new problems. Enforced in `work.py post-review`, not left to prose. 0 = no cap (not recommended).",
    "_require_review": "off (default) | changes | approval. A REAL PR-review gate, independent of branch protection. `gate()`'s mergeStateStatus only folds in reviews the base branch PROTECTION requires, so a human 'Request changes' on an unprotected base (a common staging/dev shape) is invisible to auto-merge. `changes` parks on a CHANGES_REQUESTED review or an unresolved review thread; `approval` also requires an APPROVED reviewDecision before merging. Self-review before the PR is never enough on its own - this is the review AFTER the PR. Adds a `gh pr view` read per merge; fail-open on a read error.",
    "_require_review_2": "THE LOOP REVIEWS ITS OWN PR - no human required. This is the READ side of the gate; the WRITE side is `work.py post-review`: after opening the PR, the loop runs a fresh adversarial pass over the real diff and posts `loopsmith:approve` (clears the merge) or `loopsmith:block` (sends itself back to fix + re-review). GitHub forbids formally approving your OWN PR and the loop is always the author, so a plain comment is the channel: loopsmith:approve/block/unblock, latest wins, a block overrides an approve. The same markers let a human review a loop PR too; a formal APPROVE / unresolved thread also counts when a second identity leaves one. Drive it via /sdlc-loop."
  },
  "ledger": {
    "enabled": false,
    "_comment": "Append-only team record of what the loop did: .sdlc/ledger/entries/<actor>-<pid>.jsonl, ONE FILE PER WRITING PROCESS (you only ever write your own, so concurrent appends cannot conflict - the pid, not just the actor, since several parallel loops can share one login). The team view is their union - render it with `ledger.py render <dir> --write`. Off by default; absent, the loop behaves exactly as before.",
    "actor": "",
    "_actor": "Your handle in the ledger. Empty = resolved from the authenticated account (`gh api user`), else the shell user.",
    "owners": {},
    "_owners": "Optional area -> owner overrides, e.g. {\"engine\": \"@some-login\"}. Empty = the roster is the repo's own .github/CODEOWNERS, which the host already enforces on every PR.",
    "handoff": { "label": "sdlc:dependency" },
    "_handoff": "A cross-area blocker opens an issue in the owner's area, assigned to them and carrying the goal label, so their own loop picks it up. See handoff.py.",
    "branch": "sdlc-ledger",
    "remote": "origin",
    "_branch": "The ops branch the ledger is shared on. .sdlc/ledger/ is a WORKTREE checked out to it (turn `enabled` on, then run /sdlc-ledger — or `sync.py bootstrap` — once per clone to create+seed+push it), so pulling the ledger never touches your code checkout. It is never merged into the integration branch and never runs CI - keep it unprotected. Gitignore .sdlc/ledger/ on the code branch.",
    "watch": { "interval_seconds": 900 },
    "_watch": "How often watch.sh pulls the ops branch and refreshes .sdlc/state/inbox.md, which `loop.py next` surfaces between goals.",
    "lease": { "ttl_hours": 12 },
    "_lease": "Claim lease: the loop skips a goal another actor holds an open `claimed` on (not yet done/parked/failed), so two people on one board don't start the same goal; a goal YOU hold is still yours to resume. Advisory (it sees claims already pulled to the ops branch, not a distributed lock), so keep assignee routing on too. ttl_hours expires a crashed claimer's hold so it can't block the team forever; 0 = never expire."
  },
  "telemetry": {
    "enabled": false,
    "share": true,
    "sample_phases": true,
    "_comment": "Opt-in machine-emitted event stream for the analytics dashboard - phase timings, gate verdicts, verify results, counts and durations; never code, never diffs, never prose bodies. Off by default; absent or enabled:false, nothing is written. Emitters landing in #139: verify and park (this slice), the post_review/merge/code_review gates (this slice) - the slice plan, discovery scan, and decision gate emitters are still #139 work in flight, and phase/spend/retro and the plan_review/alignment gates are #140. Events only write when `ledger.enabled` is ALSO true - `.sdlc/ledger/events/<actor>.jsonl`, same worktree as the ledger. /sdlc-doctor features reports the live state.",
    "_share": "true (default) publishes the events file on the ops branch alongside your ledger entries - same worktree, same union-merge, picked up by a teammate's next ledger pull. false asks to keep events local and out of the shared branch instead. NOT YET WIRED: until the local write path ships, every event still lands in .sdlc/ledger/events/<actor>.jsonl and still publishes with the rest of the ledger regardless of this flag - setting it to false today records your intent but changes nothing on disk yet.",
    "_sample_phases": "Reserved for a future per-phase sampling ratio, so a noisy stream of phase-boundary events can be thinned under load. Does nothing until the emitters land; setting it today is a no-op."
  },
  "action_log": { "enabled": false },
  "_action_log": "Opt-in local-only action trace — every file touched, model/effort choice, subagent dispatch and mechanically-guaranteed loop action (claim/worktree/verify/gate/record), written to .sdlc/state/log/<goal-stem>.jsonl (gitignored, per RUNTIME_IGNORES; never the ledger, never shared). Off by default; absent or enabled:false, loop.py log and every internal call site are no-ops. Read with /sdlc-log.",
  "parallel": { "enabled": false, "max_concurrent": 3, "goals": { "enabled": false, "max_concurrent": 3 } },
  "_parallel": "Run a goal's independent slices concurrently, from the declared manifest .sdlc/plans/<goal-stem>.slices.json: `slices.py plan` groups non-conflicting slices into waves (a slice that declares no files conflicts with everything and runs alone) and the loop dispatches each wave as subagents. Off by default; absent, every goal runs as one unit exactly as before.",
  "_parallel_goals": "Sibling knob, independent of parallel.enabled above: run MULTIPLE BACKLOG GOALS concurrently (F10.5-3/#375), not one goal's slices. goals.enabled:true makes /sdlc-loop's `next-batch` return up to goals.max_concurrent goals in one pass, each dispatched as its own subagent running the full research-through-PR sequence in its own worktree+branch. Off by default; absent or enabled:false, `next-batch` returns exactly one goal, byte-identical to plain `next`. A bad/non-numeric max_concurrent falls back to 3 rather than raising. The target scenario is ONE person, ONE machine, many of their OWN assigned issues - not a team coordination feature (that's what the ledger + #374's claim check are for). Refilling a freed slot MUST pass `next --skip <the other still-live goals>`, or a sibling's in-progress goal can be re-dispatched - see the SKILL.md prose (step 1a) for why the claim check alone cannot catch this.",

  "backlog_check": { "enabled": false, "action": "park", "similarity": "tfidf", "dup_threshold": 0.72, "obsolete_threshold": 0.72, "park_threshold": 0.80, "top_k": 8, "closed_window_days": "auto", "embed": { "enabled": false, "command": "", "weight": 0.5 }, "mirror": { "ttl_minutes": 60, "closed_limit": 200 } },
  "_backlog_check": "OPT-IN pre-work cross-check (backlog_check.py + mirror.py, driven by /sdlc-loop's precheck step). When enabled:true, before a picked goal spends a token the loop retrieves likely DUPLICATE / OBSOLETE-by-completed-work / BLOCKED-BY items from the rest of the backlog (+ the team ledger) via a token-free TF-IDF pass; a CONFIDENT hit is parked-with-proof (a comment carrying the evidence, then the loop advances to the next goal), a weak one is only annotated. Off by default: absent, or enabled:false, changes nothing. Zero LLM cost, secret-safe (findings carry issue refs + scrubbed shared terms, never titles/bodies), fail-open (never blocks the loop). action: park (default, park a confident hit) | flag (only ever annotate, never park). similarity: tfidf (default) | bm25 (BM25-weighted cosine, stronger on long bodies). dup_threshold / obsolete_threshold: cosine 0-1 at which an OPEN / a COMPLETED issue is a candidate. park_threshold: at/above this a finding is CONFIDENT (parks) - keep park_threshold >= dup_threshold or every candidate parks. top_k: max candidates scored per goal. closed_window_days: 'auto' scales the obsolescence window to ~50 recent merges by git velocity; a pinned integer overrides. embed: OPT-IN dense/embedding layer fused with the lexical score (max of the two) to catch PARAPHRASES that share no words. embed.enabled:true + embed.command = a provider-agnostic embedder (reads text on stdin, prints a JSON number array). embed.command runs via the shell, same trust model as verify.command - it is YOUR command. Vectors are cached in gitignored .sdlc/state/embeddings.json (content-hash keyed, only new/changed texts are embedded), so only the FIRST run over a new issue pays the embed cost and the query itself stays token-free. embed.weight scales the dense score in the fusion. Fail-open: no command / an embedder error -> lexical-only (degraded:['no_embedder']). mirror.ttl_minutes: reuse the gitignored board snapshot this long before refetching (github mode). mirror.closed_limit: how many recently-closed issues to scan for obsolescence.",

  "review": { "independent": true },
  "_review": "The maker is never the checker. Every LLM-judgment review gate (plan-review, code review, the post-PR review, and the retrospective grade) runs as a FRESH subagent that gets the PROJECT but not the AUTHOR - so it can find blast radius and disagree instead of rubber-stamping its own work (which lower-tier models do, amplifying hallucination). The reviewer brief is assembled by review_context.py (north-star + conventions + contracts + the goal + a pointer to the artifact - always the whole project, never just the diff and never the maker's transcript); /sdlc-loop dispatches one fresh subagent per gate fed only that brief.",
  "_review_independent": "true (default) = a fresh author-blind reviewer subagent per gate, grounded in the north-star + CLAUDE.md + contracts + full repo READ access so it judges the change's ripple through callers, not just the diff on screen (a diff-only reviewer cannot see what a small change breaks two files away). Where the host has no subagents it degrades honestly to an inline reviewer that still loads the brief fresh and takes the reviewer's stance. false = legacy inline behavior (the maker reviews its own work) - only for a trivial solo repo where the ceremony isn't worth it.",

  "companions": "auto",
  "model_selection": "off",
  "_model_selection_options": "off (phases run at the session model) | auto (predict a tier per goal via /sdlc-model, run that goal's phases as subagents at it)",
  "knowledge_graph": {
    "enabled": false,
    "_comment": "Opt-in research corpus. When enabled, the research-capture hook writes a provenance breadcrumb per WebSearch/WebFetch under .sdlc/knowledge/research/web/ — source + subject + a SHORT excerpt scrubbed of secret-shaped substrings, never the raw page. .sdlc/knowledge/ is gitignored by /sdlc-setup so captures stay local unless you deliberately commit them.",
    "scope": "full",
    "_scope_options": "full (code + external research + internal analysis) | research (skip code; internal analysis + external research only)",
    "builder": "graphify",
    "auto_refresh": false
  }
}
